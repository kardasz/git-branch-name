---
import ThemeSwitch from './ThemeSwitch.astro';
---

<header class="masthead">
	<div class="sigil" aria-hidden="true">
		<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round">
			<circle cx="6.5" cy="4.5" r="2.2"></circle>
			<circle cx="6.5" cy="19.5" r="2.2"></circle>
			<circle cx="17.5" cy="12" r="2.2"></circle>
			<path d="M6.5 6.7v10.6"></path>
			<path d="M15.4 12H12a5.5 5.5 0 0 1-5.5-5.5"></path>
		</svg>
	</div>

	<div class="titles">
		<h1>Git Branch Name</h1>
		<p>Paste a ticket, get every branch name. Your pasted text stays in your browser.</p>
	</div>

	<ThemeSwitch />
</header>

<style>
	.masthead {
		display: flex;
		align-items: center;
		gap: 14px;
	}

	.titles {
		margin-right: auto;
	}

	.sigil {
		width: 42px;
		height: 42px;
		flex: none;
		display: grid;
		place-items: center;
		border-radius: 13px;
		background: var(--glass-strong);
		backdrop-filter: blur(20px) saturate(180%);
		-webkit-backdrop-filter: blur(20px) saturate(180%);
		border: 1px solid var(--glass-edge-low);
		box-shadow: inset 0 1px 0 var(--inner-top);
		color: var(--accent);
	}

	h1 {
		margin: 0;
		font-size: 21px;
		font-weight: 600;
		letter-spacing: -0.021em;
		line-height: 1.2;
	}

	p {
		margin: 2px 0 0;
		font-size: 13px;
		color: var(--ink-2);
		letter-spacing: -0.005em;
	}
</style>
