---
import { BRANCH_TYPES } from '../lib/branch-types';
import { DEFAULT_LENGTH, MAX_LENGTH, MIN_LENGTH } from '../lib/branch-name';

/*
 * The prose below the generator. It exists so the page has something to index
 * and something to answer with — the widget itself is opaque to a crawler.
 *
 * Everything lives in one collapsed FAQ, including what used to be the "How it
 * works" and "Options" panels: the answers are still in the HTML of every
 * response, which is all a crawler needs, but the page no longer buries the
 * generator under two screens of prose.
 *
 * `FAQ` is the single source for both the visible questions and the FAQPage
 * JSON-LD at the bottom: schema that disagrees with the page is worse than no
 * schema, so neither is allowed to drift from the other. `example` is rendered
 * as a code block and appended to the schema answer, so the two still match.
 */
const types = BRANCH_TYPES.map((type) => `${type}/`).join(', ');

const FAQ: { q: string; a: string; example?: string }[] = [
	{
		q: 'How does the generator work?',
		a: 'Paste a JIRA link, a bare ticket key such as PROJ-142, or just the task title — whatever is on your clipboard. The ticket key is pulled out, the rest is slugified into the title, and one branch name is built for every branch type you have ticked, the unprefixed name first. There is no generate button: the list is rebuilt on every keystroke, and clicking a row copies it.',
		example: `https://acme.atlassian.net/browse/PROJ-142 Add pagination to the feed query

PROJ-142-add-pagination-to-the-feed-query
feature/PROJ-142-add-pagination-to-the-feed-query
bugfix/PROJ-142-add-pagination-to-the-feed-query
hotfix/PROJ-142-add-pagination-to-the-feed-query`,
	},
	{
		q: 'Which options can I change?',
		a: `Branch types — ${types} — one name per ticked type. Word separator: - or _ between words, with the ticket key keeping its own hyphen either way. Lowercase, on by default, lowercases the title; "Lowercase TICKET-123", off by default, lowercases the ticket key too, so trackers keep matching the branch. Include date prefixes today's date, as in feature/20260806-PROJ-142-…. Max length is the character budget for the whole name, prefix included: ${DEFAULT_LENGTH} by default, anywhere between ${MIN_LENGTH} and ${MAX_LENGTH}. Theme is light, dark, or match the system — the default.`,
	},
	{
		q: 'What is a good git branch naming convention?',
		a: 'Most teams settle on <type>/<TICKET-KEY>-<short-title>, for example feature/PROJ-142-add-feed-pagination. The type prefix groups branches in tooling, the ticket key links the branch back to the issue tracker, and the slugified title says what the branch does without anyone opening it. Keep the title lowercase, use one separator throughout, and stay somewhere around 60 characters.',
	},
	{
		q: 'How do I turn a JIRA ticket into a branch name?',
		a: 'Paste the whole issue link — https://your-company.atlassian.net/browse/PROJ-142 — followed by the issue summary. The key PROJ-142 is pulled out of the link, the rest becomes the slugified title, and every prefixed variant is generated at once. A key inside a URL always wins over one in the surrounding text, because that is the issue you actually linked.',
	},
	{
		q: 'Which branch prefixes should I use?',
		a: 'feature/ for new work, bugfix/ for a defect on the current line, hotfix/ for something going straight to production, release/ for a version being cut, chore/ for maintenance, docs/ for documentation, refactor/ for changes that keep behaviour, and test/ for test-only work. Generate them all and copy the one that fits, or untick the types your team does not use.',
	},
	{
		q: 'Should a branch name use hyphens or underscores?',
		a: 'Both are legal in a git ref, and hyphens are the common default — they match the ticket key and read better in a pull-request list. Underscores suit teams whose tooling already uses them. Switch with the word separator option; the ticket key keeps its own hyphen either way, so PROJ-142 stays greppable and JIRA still matches the branch to the issue.',
	},
	{
		q: 'Why is the ticket key kept uppercase?',
		a: 'Because it is an identifier, not a word. JIRA and most trackers match branches, commits and pull requests on the exact key, so PROJ-142 is left uppercase and keeps its own hyphen even when the title is lowercased and the separator is an underscore. Turn on "Lowercase TICKET-123" if your team prefers it lowercased anyway.',
	},
	{
		q: 'How long should a git branch name be?',
		a: `Git has no practical limit, but branch names are typed, tab-completed and read in review queues, so shorter wins. The budget here is ${DEFAULT_LENGTH} characters for the whole name including the prefix, adjustable between ${MIN_LENGTH} and ${MAX_LENGTH}. A name that does not fit is cut back at a word boundary rather than mid-word, and the row tells you it was trimmed.`,
	},
	{
		q: 'Which characters are allowed in a git branch name?',
		a: 'Git rejects spaces, the characters ~ ^ : ? * [ and \\, the sequences .. and @{, a trailing .lock, and leading or trailing dots and slashes. Rather than police that list, the generator only ever emits a–z, A–Z, 0–9, your separator and the / after the type prefix. Accents are transliterated, so "Zmień hasło" becomes zmien-haslo, and anything else collapses into a separator.',
	},
	{
		q: 'Is anything I paste sent to a server?',
		a: 'No. The page is static and the whole generator runs in your browser: there is no backend, no analytics and no network request at runtime. Ticket titles, internal project keys and customer names never leave the tab, which is the point — you can paste straight from a private tracker.',
	},
];

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	mainEntity: FAQ.map(({ q, a, example }) => ({
		'@type': 'Question',
		name: q,
		acceptedAnswer: { '@type': 'Answer', text: example ? `${a}\n\n${example}` : a },
	})),
};
---

<section class="about" aria-labelledby="faq-title">
	<article class="glass panel">
		<h2 id="faq-title">Frequently asked questions</h2>

		{
			FAQ.map(({ q, a, example }, i) => (
				<details name="faq" open={i === 0}>
					<summary>
						<h3>{q}</h3>
						<svg class="chev" width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true">
							<path
								d="m6 9 6 6 6-6"
								stroke="currentColor"
								stroke-width="2"
								stroke-linecap="round"
								stroke-linejoin="round"
							/>
						</svg>
					</summary>
					<div class="answer">
						<p>{a}</p>
						{/* prettier-ignore */}
						{example && <pre><code>{example}</code></pre>}
					</div>
				</details>
			))
		}
	</article>

	<script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />
</section>

<style>
	.about {
		margin-top: 10px;
	}

	.panel {
		padding: 8px 24px;
	}

	h2 {
		margin: 14px 0 4px;
		font-size: 16px;
		font-weight: 600;
		letter-spacing: -0.015em;
	}

	details {
		border-top: 1px solid var(--glass-edge-low);
	}

	details:first-of-type {
		border-top: none;
	}

	summary {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 16px;
		padding: 13px 0;
		cursor: pointer;
		list-style: none;
		color: var(--ink);
	}

	/* Safari still paints the disclosure triangle without this. */
	summary::-webkit-details-marker {
		display: none;
	}

	summary:hover,
	details[open] summary {
		color: var(--ink);
	}

	summary:focus-visible {
		outline: none;
		border-radius: 8px;
		box-shadow: 0 0 0 3px var(--accent-soft);
	}

	h3 {
		margin: 0;
		font-size: 13.5px;
		font-weight: 600;
		letter-spacing: -0.008em;
	}

	.chev {
		flex: none;
		color: var(--ink-3);
		transition: transform 0.18s cubic-bezier(0.2, 0.8, 0.3, 1);
	}

	summary:hover .chev {
		color: var(--ink);
	}

	details[open] .chev {
		transform: rotate(180deg);
	}

	.answer {
		padding: 0 0 16px;
		max-width: 74ch;
	}

	p {
		margin: 0;
		font-size: 13.5px;
		line-height: 1.62;
		color: var(--ink-2);
	}

	pre {
		margin: 12px 0 0;
		padding: 14px 16px;
		border-radius: var(--r-md);
		background: var(--field);
		border: 1px solid var(--field-edge);
		overflow-x: auto;
	}

	pre code {
		font-family: var(--font-mono);
		font-size: 12px;
		line-height: 1.75;
		color: var(--ink-2);
		white-space: pre;
	}
</style>
