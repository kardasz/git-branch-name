---
// Decorative backdrop — a slow git graph seen through the glass above it.
---

<div class="ambient" aria-hidden="true">
	<canvas id="ambient-graph"></canvas>
</div>

<script>
	import '../scripts/ambient';
</script>

<style>
	.ambient {
		position: fixed;
		inset: 0;
		z-index: 0;
		overflow: hidden;
		background:
			radial-gradient(120% 90% at 12% 8%, var(--bg-1) 0%, transparent 62%),
			radial-gradient(110% 80% at 88% 12%, var(--bg-2) 0%, transparent 58%),
			radial-gradient(130% 100% at 50% 100%, var(--bg-3) 0%, transparent 66%),
			var(--bg-base);
	}

	canvas {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		filter: blur(0.4px);
		-webkit-mask-image: linear-gradient(180deg, transparent, #000 18%, #000 82%, transparent);
		mask-image: linear-gradient(180deg, transparent, #000 18%, #000 82%, transparent);
	}
</style>
