---
// Copy confirmation. Announced politely so it reaches screen readers too.
---

<div class="toast" id="toast" role="status" aria-live="polite">
	<svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
		<path d="M2.5 7.4 5.6 10.5 11.5 3.9"></path>
	</svg>
	<span id="toast-label">Copied</span>
	<span class="mono" id="toast-detail"></span>
</div>

<style>
	.toast {
		position: fixed;
		left: 50%;
		bottom: 28px;
		z-index: 20;
		transform: translate(-50%, 14px);
		display: flex;
		align-items: center;
		gap: 8px;
		padding: 9px 16px;
		border-radius: 999px;
		background: var(--glass-strong);
		backdrop-filter: blur(24px) saturate(180%);
		-webkit-backdrop-filter: blur(24px) saturate(180%);
		border: 1px solid var(--glass-edge-low);
		box-shadow: var(--glass-shadow), inset 0 1px 0 var(--inner-top);
		color: var(--ink);
		font-size: 13px;
		opacity: 0;
		pointer-events: none;
		transition:
			opacity 0.2s ease,
			transform 0.24s cubic-bezier(0.2, 0.8, 0.3, 1);
	}

	.toast.on {
		opacity: 1;
		transform: translate(-50%, 0);
	}

	.mono {
		max-width: 46ch;
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
		font-family: var(--font-mono);
		font-size: 12.5px;
		color: var(--ink-2);
	}
</style>
