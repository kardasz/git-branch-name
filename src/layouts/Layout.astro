---
import '../styles/global.css';
import CookieConsent from '../components/CookieConsent.astro';

interface Props {
	title?: string;
	description?: string;
}

const {
	title = 'Git Branch Name Generator — JIRA ticket to branch name',
	description = 'Free git branch name generator. Paste a JIRA link, ticket key or plain title and copy a clean branch name — feature/, bugfix/, hotfix/. Runs in your browser.',
} = Astro.props;

// `Astro.site` is set in astro.config.mjs, so every absolute URL below is built
// from one source of truth rather than a hardcoded origin.
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL('/og.png', Astro.site);

const structuredData = {
	'@context': 'https://schema.org',
	'@type': 'WebApplication',
	name: 'Git Branch Name',
	alternateName: 'Git Branch Name Generator',
	url: Astro.site?.href,
	description,
	applicationCategory: 'DeveloperApplication',
	operatingSystem: 'Any',
	browserRequirements: 'Requires JavaScript.',
	isAccessibleForFree: true,
	offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
	license: 'https://opensource.org/licenses/MIT',
	author: {
		'@type': 'Person',
		name: 'Krzysztof Kardasz',
		url: 'https://kardasz.eu',
	},
};
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<link rel="canonical" href={canonical} />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />
		<meta name="author" content="Krzysztof Kardasz" />
		<meta name="color-scheme" content="light dark" />
		<meta name="theme-color" content="#e7ecf3" media="(prefers-color-scheme: light)" />
		<meta name="theme-color" content="#0d1b2a" media="(prefers-color-scheme: dark)" />
		<title>{title}</title>

		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="Git Branch Name" />
		<meta property="og:locale" content="en_US" />
		<meta property="og:url" content={canonical} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={ogImage} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content="Git Branch Name — paste a ticket, get every branch name." />

		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImage} />

		<script type="application/ld+json" is:inline set:html={JSON.stringify(structuredData)} />

		<!-- Applied before first paint so a chosen theme never flashes the other one. -->
		<script is:inline>
			try {
				const theme = localStorage.getItem('gbn-theme');
				if (theme === 'dark' || theme === 'light') document.documentElement.dataset.theme = theme;
			} catch {
				// Storage blocked — fall back to the system preference.
			}
		</script>
	</head>
	<body>
		<slot />
		<CookieConsent />
	</body>
</html>
